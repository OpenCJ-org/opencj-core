#include "ui/menudef.h"
#include "ui_mp/scriptmenus/opencj_common.inc"

// Tutorial mode offer, shown after a new player answers "No" in opencj_tutorial_intro.
// Answers go to server-gsc/opencj/tutorial.gsc: "yes" starts tutorial mode, "no"
// keeps normal mode, "later" asks again on the next connection.
{
    menuDef
    {
        name opencj_tutorial_offer
        rect DEFAULT_RECT(0 0 FULLSCREEN_X FULLSCREEN_Y)
        style WINDOW_STYLE_EMPTY
        focuscolor WHITE_COLOR
        popup
        onOpen
        {
            setFocus offer_yes;
        }
        onEsc
        {
            scriptMenuResponse "later";
            close self;
        }
        // Dims the whole screen, also outside the 4:3 area on widescreen displays.
        itemDef
        {
            name dimmer
            rect 0 0 640 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
            style WINDOW_STYLE_FILLED
            backcolor 0 0 0 .55
            visible 1
            decoration
        }

        FIXED_RECT(.025 .045 .052 1, 148, 142, 344, 196)
        FIXED_RECT(HIGHLIGHT_COLOR, 148, 142, 344, 2)
        FIXED_RECT_TXT(
            1, "Start in tutorial mode?",
            UI_FONT_NORMAL, ITEM_TEXTSTYLE_NORMAL,
            .32, ITEM_ALIGN_MIDDLE_CENTER, 0, 0,
            NO_COLOR, WHITE_COLOR,
            158, 156, 324, 28
        )
        FIXED_RECT_TXT(
            1, "The mechanics of CoD4 CodJumper are very complex",
            UI_FONT_NORMAL, ITEM_TEXTSTYLE_NORMAL,
            .22, ITEM_ALIGN_MIDDLE_CENTER, 0, 0,
            NO_COLOR, LIGHTGREY_COLOR,
            158, 188, 324, 18
        )
        FIXED_RECT_TXT(
            1, "and the learning curve is very steep, so we strongly",
            UI_FONT_NORMAL, ITEM_TEXTSTYLE_NORMAL,
            .22, ITEM_ALIGN_MIDDLE_CENTER, 0, 0,
            NO_COLOR, LIGHTGREY_COLOR,
            158, 206, 324, 18
        )
        FIXED_RECT_TXT(
            1, "recommend starting in tutorial mode.",
            UI_FONT_NORMAL, ITEM_TEXTSTYLE_NORMAL,
            .22, ITEM_ALIGN_MIDDLE_CENTER, 0, 0,
            NO_COLOR, LIGHTGREY_COLOR,
            158, 224, 324, 18
        )
        FIXED_RECT_TXT(
            1, "The server sets your FPS while you jump. Tutorial runs",
            UI_FONT_NORMAL, ITEM_TEXTSTYLE_NORMAL,
            .20, ITEM_ALIGN_MIDDLE_CENTER, 0, 0,
            NO_COLOR, LIGHTGREY_COLOR,
            158, 250, 324, 16
        )
        FIXED_RECT_TXT(
            1, "do not count for leaderboards or challenges.",
            UI_FONT_NORMAL, ITEM_TEXTSTYLE_NORMAL,
            .20, ITEM_ALIGN_MIDDLE_CENTER, 0, 0,
            NO_COLOR, LIGHTGREY_COLOR,
            158, 266, 324, 16
        )
        FIXED_RECT_TXT(
            1, "Switch any time with !tutorial.",
            UI_FONT_NORMAL, ITEM_TEXTSTYLE_NORMAL,
            .20, ITEM_ALIGN_MIDDLE_CENTER, 0, 0,
            NO_COLOR, LIGHTGREY_COLOR,
            158, 282, 324, 16
        )
        BUTTON_RECT_TXT_ACTION_BG(
            offer_no, "No",
            play "mouse_click";
            scriptMenuResponse "no";
            close self,
            .10 .19 .22 1, WHITE_COLOR,
            UI_FONT_NORMAL, .24,
            222, 304, 90, 24
        )
        BUTTON_RECT_TXT_ACTION_BG(
            offer_yes, "Yes",
            play "mouse_click";
            scriptMenuResponse "yes";
            close self,
            .10 .19 .22 1, WHITE_COLOR,
            UI_FONT_NORMAL, .24,
            328, 304, 90, 24
        )
    }

}
