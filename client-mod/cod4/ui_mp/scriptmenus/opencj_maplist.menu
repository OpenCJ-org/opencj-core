        FIXED_RECT_DVARRIGHT_SCALED(ADDPREFIX("author"), BLACK_TRANSPARENT_COLOR, WHITE_COLOR, 0.25, (RIGHT_CONTENT_X + 2 + ((RIGHT_CONTENT_X_SIZE - 2) / 2)), (RIGHT_CONTENT_Y + 2 + MAPIMAGE_Y_SIZE - 20), ((RIGHT_CONTENT_X_SIZE - 2) / 2), 20)

