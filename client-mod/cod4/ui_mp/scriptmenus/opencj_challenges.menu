#include "ui/menudef.h"
{
    menuDef
    {
        name opencj_challenges
        rect 0 0 640 480
        style WINDOW_STYLE_EMPTY
        focuscolor 1 1 1 1
        onClose
        {
            scriptMenuResponse "sql_close";
        }
        onOpen
        {
            setDvar "ocj_ch_busy" "1";
            scriptMenuResponse "open";
        }
        onEsc
        {
            close self;
            open openCJ_ingame;
        }
        itemDef
        {
            name panel
            rect 24 28 592 428 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT
            exp rect H (dvarFloat("ocj_ch_height") + 40)
            style WINDOW_STYLE_FILLED
            backcolor .015 .025 .03 .94
            visible 1
            decoration
        }

        itemDef
        {
            name accent
            rect 24 28 592 2 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT
            style WINDOW_STYLE_FILLED
            backcolor 0 .75 .85 1
            visible 1
            decoration
        }

        itemDef
        {
            name heading
            rect 36 36 460 22 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT
            type ITEM_TYPE_TEXT
            text "CHALLENGES"
            textfont UI_FONT_NORMAL
            textscale .3
            textalign ITEM_ALIGN_MIDDLE_LEFT
            forecolor 0 .85 .95 1
            visible 1
            decoration
        }

        // Player identity and advancement are separate from the challenge category tabs.
        itemDef
        {
            name progressLabel
            rect 36 63 220 11 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT
            type ITEM_TYPE_TEXT
            text "YOUR PROGRESS"
            textfont UI_FONT_NORMAL
            textscale .14
            textalign ITEM_ALIGN_MIDDLE_LEFT
            forecolor .65 .75 .78 1
            visible 1
            decoration
        }

        itemDef
        {
            name progressLoading
            rect 36 78 550 25 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT
            type ITEM_TYPE_TEXT
            dvar "ocj_ch_summary"
            textfont UI_FONT_NORMAL
            textscale .18
            textalign ITEM_ALIGN_MIDDLE_LEFT
            forecolor .8 .88 .9 1
            visible when (!dvarInt("ocj_ch_progress_ready"))
            decoration
        }

        itemDef
        {
            name ownRank1
            rect 36 78 26 26 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT
            style WINDOW_STYLE_SHADER
            background "opencj_rank_1"
            exp material ("opencj_rank_" + dvarString("ocj_ch_rank"))
            forecolor 1 1 1 1
            visible when (dvarInt("ocj_ch_progress_ready"))
            decoration
        }

        itemDef
        {
            name playerLevel
            rect 74 76 240 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT
            type ITEM_TYPE_TEXT
            dvar "ocj_ch_player_level"
            textfont UI_FONT_NORMAL
            textscale .22
            textalign ITEM_ALIGN_MIDDLE_LEFT
            forecolor 1 1 1 1
            visible when (dvarInt("ocj_ch_progress_ready"))
            decoration
        }

        itemDef
        {
            name playerPoints
            rect 74 93 240 12 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT
            type ITEM_TYPE_TEXT
            dvar "ocj_ch_player_points"
            textfont UI_FONT_NORMAL
            textscale .16
            textalign ITEM_ALIGN_MIDDLE_LEFT
            forecolor .75 .82 .86 1
            visible when (dvarInt("ocj_ch_progress_ready"))
            decoration
        }

        itemDef
        {
            name nextLevel
            rect 370 78 116 14 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT
            type ITEM_TYPE_TEXT
