        }

        itemDef
        {
            name progressTrack
            rect 370 98 234 3 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT
            style WINDOW_STYLE_FILLED
            backcolor .16 .23 .27 1
            visible when (dvarInt("ocj_ch_progress_ready"))
            decoration
        }

        itemDef
        {
            name progressFill
            rect 370 98 0 3 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT
            exp rect W (234 * dvarFloat("ocj_ch_progress"))
            style WINDOW_STYLE_FILLED
            backcolor .91 .765 .35 1
            visible when (dvarInt("ocj_ch_progress_ready") && dvarFloat("ocj_ch_progress") > 0)
            decoration
        }

        itemDef
        {
            name progressDivider
            rect 36 113 568 1 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT
            style WINDOW_STYLE_FILLED
            backcolor .24 .34 .4 .55
            visible 1
            decoration
        }

        // One transparent control: no enclosing border, backplate, tint or hover fade.
        itemDef
        {
            name competitive
            rect 36 125 78 46 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT
            type ITEM_TYPE_BUTTON
            style WINDOW_STYLE_EMPTY
            visible 1
            mouseEnter
            {
                play "mouse_over";
            }
            action
            {
                play "mouse_click";
                scriptMenuResponse "0";
            }
        }

        itemDef
        {
            name competitiveIcon
            rect 43 127 64 32 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT
            style WINDOW_STYLE_SHADER
            background "opencj_competitive"
            forecolor 1 1 1 1
            visible 1
            decoration
        }

        itemDef
        {
            name competitiveLabel
            rect 36 160 78 10 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT
            type ITEM_TYPE_TEXT
            text "Top 10"
            textfont UI_FONT_NORMAL
            textscale .14
            textalign ITEM_ALIGN_MIDDLE_CENTER
            forecolor .85 .9 .93 1
            visible 1
            decoration
        }

        itemDef
        {
            name exit
            rect 582 36 22 22 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT
            type ITEM_TYPE_BUTTON
            style WINDOW_STYLE_FILLED
            backcolor .55 .12 .12 .8
            text "X"
            textfont UI_FONT_NORMAL
            textscale .23
            textalign ITEM_ALIGN_MIDDLE_CENTER
            forecolor 1 1 1 1
            visible 1
            action
            {
                play "mouse_click";
                close self;
                open openCJ_ingame;
            }
        }

