#include "ui/menudef.h"
#include "ui_mp/scriptmenus/opencj_common.inc"

// Server browser: up to ten listed OpenCJ servers sharing this database. The game
// server fills the rows, validates the selection and sends the connect command.

#define ADDPREFIX(val)          OPENCJDVAR("servers_")val

#undef OUTER_FRAME_SIZE_X
#define OUTER_FRAME_SIZE_X      600

#undef OUTER_FRAME_SIZE_Y
#define OUTER_FRAME_SIZE_Y      340

#define EXITBTN_ORG_X           (OUTER_FRAME_ORG_X + OUTER_FRAME_SIZE_X - EXITBTN_SIZE_X - 10)
#define EXITBTN_ORG_Y           (OUTER_FRAME_ORG_Y + (H_SEP_ORG_Y / 2) - (EXITBTN_SIZE_Y / 2))
#define EXITBTN_SIZE_X          26
#define EXITBTN_SIZE_Y          22

#define LIST_X                  (OUTER_FRAME_ORG_X + 10)
#define LIST_Y                  (OUTER_FRAME_ORG_Y + H_SEP_ORG_Y + 10)
#define LIST_SIZE_X             (OUTER_FRAME_SIZE_X - 20)
#define HEADER_SIZE_Y           16
#define ROW_SIZE_Y              20
#define ROW_ORG_Y(_idx)         (LIST_Y + HEADER_SIZE_Y + 4 + ((ROW_SIZE_Y + 1) * _idx))

// Column positions within the list.
#define NAME_X                  (LIST_X)
#define NAME_SIZE_X             250
#define LOCATION_X              (LIST_X + 255)
#define LOCATION_SIZE_X         110
#define MAP_X                   (LIST_X + 370)
#define MAP_SIZE_X              140
#define PLAYERS_X               (LIST_X + 515)
#define PLAYERS_SIZE_X          65

#define FOOTER_Y                (ROW_ORG_Y(10) + 6)
#define FOOTER_BTN_SIZE_X       90
#define FOOTER_BTN_SIZE_Y       18
#define JOIN_BTN_X              (LIST_X + LIST_SIZE_X - FOOTER_BTN_SIZE_X)
#define REFRESH_BTN_X           (JOIN_BTN_X - FOOTER_BTN_SIZE_X - 10)

#define WHEN_ROW_USED(_idx)     (dvarString(ADDPREFIX("name"#_idx)) != "")
#define WHEN_ROW_SELECTED(_idx) (dvarString(ADDPREFIX("selected")) == #_idx)
#define WHEN_ANY_SELECTED       (dvarString(ADDPREFIX("selected")) != "")

// One clickable row: selection highlight, the click area and four text columns.
// The text items are decorations, so clicks reach the row button.
#define SERVER_ROW(_name, _idx) \
    FIXED_RECT_WHEN(WHEN_ROW_SELECTED(_idx), BRIGHT_BLUE_COLOR_01, LIST_X, ROW_ORG_Y(_idx), LIST_SIZE_X, ROW_SIZE_Y) \
    BUTTON_RECT_BORDER_WHEN(_name, WHEN_ROW_USED(_idx), BT_COLOR, WHITE_COLOR, UI_FONT_NORMAL, 0.23, \
        LIST_X, ROW_ORG_Y(_idx), LIST_SIZE_X, ROW_SIZE_Y, WHITE_TRANSPARENT_COLOR, 0) \
    FIXED_RECT_DVARLEFT_SCALED(ADDPREFIX("name"#_idx), NO_COLOR, WHITE_COLOR, 0.23, \
        NAME_X, ROW_ORG_Y(_idx), NAME_SIZE_X, ROW_SIZE_Y) \
    FIXED_RECT_DVARLEFT_SCALED(ADDPREFIX("location"#_idx), NO_COLOR, LIGHTGREY_COLOR, 0.21, \
        LOCATION_X, ROW_ORG_Y(_idx), LOCATION_SIZE_X, ROW_SIZE_Y) \
    FIXED_RECT_DVARLEFT_SCALED(ADDPREFIX("map"#_idx), NO_COLOR, LIGHTGREY_COLOR, 0.21, \
        MAP_X, ROW_ORG_Y(_idx), MAP_SIZE_X, ROW_SIZE_Y) \
    FIXED_RECT_DVARLEFT_SCALED(ADDPREFIX("players"#_idx), NO_COLOR, WHITE_COLOR, 0.21, \
        PLAYERS_X, ROW_ORG_Y(_idx), PLAYERS_SIZE_X, ROW_SIZE_Y)

{
    menuDef
    {
        name        opencj_servers
        rect        DEFAULT_RECT(0 0 FULLSCREEN_X FULLSCREEN_Y)
        focuscolor  COLOR_UNFOCUSED
        style       WINDOW_STYLE_EMPTY
        blurWorld   5.0
        onOpen
        {
            scriptMenuResponse "open_servers"
        }
        onEsc
        {
            close self;
        }

        // Background
        FIXED_RECT(BG_COLOR, OUTER_FRAME_ORG_X, OUTER_FRAME_ORG_Y, OUTER_FRAME_SIZE_X, OUTER_FRAME_SIZE_Y)

        // Header bar
        itemDef
        {
            style       WINDOW_STYLE_FILLED
            backcolor   HIGHLIGHT_COLOR
            rect        DEFAULT_RECT(0 0 OUTER_FRAME_SIZE_X 5)
            origin      OUTER_FRAME_ORG_X (OUTER_FRAME_ORG_Y - 5)
            visible     1
            decoration
        }
        FIXED_RECT_TXTLEFT_SCALED("Servers", 0.40, NO_COLOR, WHITE_COLOR, OUTER_FRAME_ORG_X, OUTER_FRAME_ORG_Y, 300, 50)

        OPENCJ_CLOSE_BUTTON(exit, close self;
        close opencj_ingame, EXITBTN_ORG_X, EXITBTN_ORG_Y)

        FIXED_RECT(BG_NAVSEP_COLOR, OUTER_FRAME_ORG_X, (OUTER_FRAME_ORG_Y + H_SEP_ORG_Y), OUTER_FRAME_SIZE_X, 1)

        // Column headers
        FIXED_RECT_TXTLEFT_SCALED("Server", 0.22, NO_COLOR, LIGHTGREY_COLOR, NAME_X, LIST_Y, NAME_SIZE_X, HEADER_SIZE_Y)
        FIXED_RECT_TXTLEFT_SCALED("Location", 0.22, NO_COLOR, LIGHTGREY_COLOR, LOCATION_X, LIST_Y, LOCATION_SIZE_X, HEADER_SIZE_Y)
        FIXED_RECT_TXTLEFT_SCALED("Map", 0.22, NO_COLOR, LIGHTGREY_COLOR, MAP_X, LIST_Y, MAP_SIZE_X, HEADER_SIZE_Y)
        FIXED_RECT_TXTLEFT_SCALED("Players", 0.22, NO_COLOR, LIGHTGREY_COLOR, PLAYERS_X, LIST_Y, PLAYERS_SIZE_X, HEADER_SIZE_Y)
        FIXED_RECT(BG_NAVSEP_COLOR, LIST_X, (LIST_Y + HEADER_SIZE_Y + 1), LIST_SIZE_X, 1)

        SERVER_ROW(server0, 0)
        SERVER_ROW(server1, 1)
        SERVER_ROW(server2, 2)
        SERVER_ROW(server3, 3)
        SERVER_ROW(server4, 4)
        SERVER_ROW(server5, 5)
        SERVER_ROW(server6, 6)
        SERVER_ROW(server7, 7)
        SERVER_ROW(server8, 8)
        SERVER_ROW(server9, 9)

        // Footer: status text, Refresh and Join
        FIXED_RECT_DVARLEFT_SCALED(ADDPREFIX("status"), NO_COLOR, LIGHTGREY_COLOR, 0.22,
            LIST_X, FOOTER_Y, 300, FOOTER_BTN_SIZE_Y)
        BUTTON_RECT_BORDER_TXT(refresh, "Refresh", "",
            NO_COLOR, WHITE_COLOR, UI_FONT_NORMAL, 0.24,
            REFRESH_BTN_X, FOOTER_Y, FOOTER_BTN_SIZE_X, FOOTER_BTN_SIZE_Y, WHITE_TRANSPARENT_COLOR, 0.5)
        BUTTON_RECT_BORDER_TXT_WHEN(join, WHEN_ANY_SELECTED, "Join", "",
            NO_COLOR, WHITE_COLOR, UI_FONT_NORMAL, 0.24,
            JOIN_BTN_X, FOOTER_Y, FOOTER_BTN_SIZE_X, FOOTER_BTN_SIZE_Y, WHITE_TRANSPARENT_COLOR, 0.5)
    } // menuDef
}

