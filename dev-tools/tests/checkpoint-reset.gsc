main()
{
    wait 2;
    level.resetFailures=0;
    cps=buildHard();
    rows=openCJ\checkpointReset::rowsFromActive(cps,"hard");
    check(isDefined(rows)&&rows.size==78,"Hard restores all 78 logical checkpoints");
    cp=openCJ\checkpointCreation::_decode(rows[45]);
    check(cp.alternatives.size==1,"checkpoint 46 retains both areas");
    cp=openCJ\checkpointCreation::_decode(rows[77]);check(cp.finish,"finish restored");
    check(!isDefined(openCJ\checkpointReset::rowsFromActive([],"hard")),"empty route refused");
    check(!isDefined(openCJ\checkpointReset::rowsFromActive(cps,"absent")),"wrong route refused");
    cps[78].ender=undefined;
    check(!isDefined(openCJ\checkpointReset::rowsFromActive(cps,"hard")),"route without finish refused");
    cps[78].ender="hard";cps[0].area=[];
    check(!isDefined(openCJ\checkpointReset::rowsFromActive(cps,"hard")),"invalid geometry refused");
    p=spawnStruct();p.cpc=spawnStruct();p.cpc.route="hard";p.cpc.path="reset_fixture";
    p.cpc.rows=rows;p.cpc.selected=78;p.cpc.draft=openCJ\checkpointCreation::_empty();p.cpc.revision=0;p.cpc.routeHex="#ff7777";
    check(p openCJ\checkpointCreation::_save(),"fixture saved");
    backup=openCJ\checkpointReset::backupDraft("reset_fixture",1);
    restored=openCJ\checkpointCreation::_read(backup+".b","hard");
    check(isDefined(restored)&&restored.rows.size==78&&restored.rows[77]==rows[77],"backup preserves complete snapshot");
    backup2=openCJ\checkpointReset::backupDraft("reset_fixture",1);
    check(backup2!=backup,"repeated reset cannot overwrite backup");
    p.cpc.rows=[];p.cpc.rows[0]=rows[0];p openCJ\checkpointCreation::_save();
    restored=openCJ\checkpointCreation::_read(backup+".b","hard");
    check(restored.rows.size==78,"backup survives subsequent draft changes");
    printf("RESET SELFTEST COMPLETE failures="+level.resetFailures+"\n");
}
check(ok,label)
{
    if(!ok){level.resetFailures++;printf("RESET SELFTEST FAIL "+label+"\n");}
    else printf("RESET SELFTEST PASS "+label+"\n");
}

