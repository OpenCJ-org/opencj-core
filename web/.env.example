# Copy to web/.env and fill in. web/.env is private and ignored by Git.

# Password of the read-only website database account. tools/grant_web_access.py
# creates one and writes it here when this is empty.
WEB_DB_PASSWORD=

# Address players type after /connect.
WEB_CONNECT_ADDRESS=opencj.org

# Optional Discord invite shown on the homepage, e.g. https://discord.gg/abc123
WEB_DISCORD_INVITE_URL=

# Folder that holds the game's usermaps/<mapname>/ folders, and its group ID.
WEB_USERMAPS_DIR=/path/to/usermaps
WEB_USERMAPS_GID=1000

# Optional; defaults shown.
# WEB_COMPOSE_PROJECT=opencj-web
# WEB_GAME_NETWORK=opencj-dev_default
# WEB_DB_HOST=db
# WEB_DB_PORT=3306
# WEB_DB_NAME=openCJ_cod4
# WEB_DB_USER=opencj_web
# WEB_GAME_HOST=server
# WEB_GAME_PORT=28960
# WEB_BIND_IP=127.0.0.1
# WEB_PORT=8090
# WEB_REBUILD_INTERVAL_SECONDS=60
